<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. Same opt-in list as backup_rules.xml: settings only, never voices. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="qvoice_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="qvoice_settings.xml" />
    </device-transfer>
</data-extraction-rules>
