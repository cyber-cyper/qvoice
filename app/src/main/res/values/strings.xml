    <!-- About -->
    <string name="about_title">About QVoice</string>
    <string name="action_about">About QVoice</string>
    <string name="action_back">Back</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_tagline">Natural voices for every app, fully offline.</string>
    <string name="about_licence_title">Free software</string>
    <string name="about_licence_body">QVoice is free software under the GNU General Public License, version 3 or later. You can use, study, share and change it. It comes with no warranty.</string>
    <string name="about_source_title">Source code</string>
    <string name="about_source_missing">Not published yet (development build).</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy_body">Everything QVoice says is generated on your phone: your text never leaves the device, and QVoice collects no data. The reader keeps only the last text you opened, and your place in it, on this phone, so you can continue later. Voices you choose to download come from GitHub, which sees the download request like any website visit.</string>
