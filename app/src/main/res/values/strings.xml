    <!-- Home: first-run setup card (shown until QVoice is the preferred engine) -->
    <string name="setup_title">Make QVoice your phone\'s voice</string>
    <string name="setup_body">Then every app that reads aloud — screen readers, e-book readers, maps — speaks with QVoice, even offline.</string>
    <string name="setup_steps">In the settings that open, tap “Preferred engine” and choose “QVoice Text-to-Speech”.</string>
    <string name="setup_note">Riniso apps can use QVoice without this step.</string>

